# Trigger.dev — server-side only, never expose to browser
TRIGGER_SECRET_KEY=

# Anthropic — used by Trigger.dev task (not Next.js)
ANTHROPIC_API_KEY=

# Public app URL (your Vercel domain or http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=

# Supabase — get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key — server-side only, used by Stripe webhook handler
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create a $29/mo product in Stripe dashboard and paste the price ID here
STRIPE_PRICE_ID=
